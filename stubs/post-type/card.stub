<?php
use App\Models\Post;
use Livewire\Component;

new class extends Component {
    public Post $post;
};
?>

{{-- Default body shows tags, title and a content excerpt. See components/post-card.blade.php for options. --}}
<x-post-card :post="$post" class="bg-white">
    @if($post->hasMedia('cover'))
        <x-slot:media>
            <img src="{{ $post->getFirstMediaUrl('cover') }}" class="card-img-top rounded-0" alt="{{ $post->title }}" loading="lazy">
        </x-slot:media>
    @endif

    @if(! empty($post->meta_data['subtitle']))
        <p class="text-muted small mt-2 mb-0">{{ $post->meta_data['subtitle'] }}</p>
    @endif
</x-post-card>
